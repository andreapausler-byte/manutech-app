# ─── Supabase Configuration ───────────────────────────────
# Crea un progetto gratuito su https://supabase.com
# Vai in Settings → API per trovare URL e chiave

VITE_SUPABASE_URL=https://tuoprogetto.supabase.co
VITE_SUPABASE_ANON_KEY=la_tua_chiave_anon_pubblica

# ─── Web Push (VAPID) ─────────────────────────────────────
# Genera le chiavi VAPID con: npx web-push generate-vapid-keys
# La chiave pubblica va qui, la privata nei Supabase Edge Function secrets

VITE_VAPID_PUBLIC_KEY=la_tua_chiave_vapid_pubblica_base64url

# ─── Assistente AI (Edge Function assistant-chat) ─────────
# La chiave va configurata come Supabase Edge Function Secret,
# NON come variabile VITE_ frontend (niente chiavi in bundle JS):
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-xxxxx
#   supabase functions deploy assistant-chat
#
# Ottieni la chiave su https://console.anthropic.com/settings/keys
# L'assistente usa il modello claude-haiku-4-5-20251001.

# ─── Nota ─────────────────────────────────────────────────
# Se queste variabili non sono configurate, l'app funziona
# in modalità demo con localStorage (dati locali al browser)
# Senza VITE_VAPID_PUBLIC_KEY le notifiche push in background
# non funzionano, ma l'app resta usabile con Realtime + polling
# In demo mode l'Assistente AI è disabilitato (banner informativo).

# ─── Feature Flags ────────────────────────────────────────
# ManuTech v6 "Amarcord" — nuovo design desktop in sandbox.
# Quando attivo, aggiunge la voce "v6 Amarcord" alla sidebar admin
# con Command Center + Ticket Board + Ticket Detail (dati mock).
# L'admin esistente non è toccato. Default: spento.

VITE_MT_V6=false
