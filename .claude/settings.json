{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint --fix --no-error-on-unmatched-pattern \"$CLAUDE_FILE_PATH\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "compaction",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'CONTESTO POST-COMPACTION: Progetto ManuTech (React 19 + Supabase). Leggi CLAUDE.md alla root per il contesto completo.'"
          }
        ]
      }
    ]
  }
}
